{
  "name": "engram",
  "version": "0.1.0",
  "description": "A governed, bitemporal memory store for agents, on Node’s built-in SQLite.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliabbas-muhammadi/engram.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "bench": "node --experimental-strip-types bench/run.ts",
    "clean": "rm -rf dist bench/.out/*.sqlite"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "typescript": "^5.9.2"
  }
}
